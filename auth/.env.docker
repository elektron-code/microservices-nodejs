### BASE
SERVICE_NAME=auth
NODE_ENV=local

### HTTP
HTTP_PORT=9001
HTTP_HOST=0.0.0.0
HTTP_PREFIX=/api/auth
HTTP_VERSION=1

### JWT
JWT_ALG=HS256
JWT_ACCESS_SECRET=accessSecret
JWT_ACCESS_EXP=1h
JWT_REFRESH_SECRET=refreshSecret
JWT_REFRESH_EXP=24h

### REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

### KAFKA
KAFKA_CLIENT_ID=auth
KAFKA_CONSUMER_GROUP_ID=auth-consumer
KAFKA_CLIENT_BROKERS=kafka:9092
KAFKAJS_NO_PARTITIONER_WARNING=1

### INTERNAL SERVICES
ACCOUNT_URL=http://account:9000/api/account